<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
    <variables>
        <!-- Connection strings (Replace with actual SQL Server connection details if needed) -->
        <variable name="ProdDBConnStr" type="string" value="sqlserver://sa:Password123!@localhost:1433?database=PROD&amp;trustServerCertificate=true" />
        <variable name="Database1ConnStr" type="string" value="sqlserver://sa:Password123!@localhost:1433?database=database1&amp;trustServerCertificate=true" />
        <variable name="Database2ConnStr" type="string" value="sqlserver://sa:Password123!@localhost:1433?database=database2&amp;trustServerCertificate=true" />

        <!-- Initial value for ProcessDate -->
        <variable name="ProcessDate" type="string" value="" />

        <!-- Query to drive the foreach loop -->
        <variable name="GetTablesQuery" value="SELECT source_table, destination_table, column_list, application, processing_date FROM [dbo].[table_xfr_map] WHERE CAST(processing_date AS DATE) = CAST('{{ProcessDate}}' AS DATE)" />
    </variables>

    <databases>
        <database name="PROD" connection_string="{{ProdDBConnStr}}" />
        <database name="database1" connection_string="{{Database1ConnStr}}" />
        <database name="database2" connection_string="{{Database2ConnStr}}" />
    </databases>

    <flow>
        <!-- 1. Fetch ProcessDate (today's date in format YYYY-MM-DD) and set to ProcessDate variable -->

        <script id="GetProcessDate" language="go" output_var="ProcessDate">
            <![CDATA[
            package main
                import (
                    "fmt"
                    "time"
                )
                func main() {
                    today := time.Now().Format("2006-01-02")
                    fmt.Println(today)
                }   
            ]]>
        </script>
        <!-- Diagnostic Script: Show rows in mapping table to help debug dates and values -->

        <!-- 2. Iterate through each source/destination mapping from [table_xfr_map] -->
        <foreach id="TableLoop" language="sql" db="PROD" var="GetTablesQuery">
            <group id="TransferTableGroup">
                <!-- Log the transfer details -->
                <script id="LOG_TableLoop_Each_IDX" language="go">
                    <![CDATA[
                            package main
                            import (
                                "fmt"
                                "host/vars"
                            )
                            func main() {
                                sourceTable := vars.GetString("source_table")
                                destinationTable := vars.GetString("destination_table")
                                idx := vars.GetInt("LOOP_INDEX")
                                fmt.Printf("[Loop #%d] Go script processing source table: %s, destination table: %s\n", idx, sourceTable, destinationTable)
                            }
                            ]]>
                </script>

                <!-- 3. Truncate the target table -->
                <sql id="TruncateTable" db="database2" description="Truncate destination table to prepare for import">
                    <![CDATA[
                    TRUNCATE TABLE {{destination_table}};
                    ]]>
                </sql>
                <!-- 4. Stream data from database1 to database2 directly using sqlStream -->
                <sql_bulk id="MSSQL_BLK_STREAM_to_table_list" db="database1" target_db="database2" target_table="{{destination_table}}" batch_size="25000" tablock="true" check_constraints="true" fire_triggers="false" keep_nulls="true" description="Stream data in bulk from source table to destination table">
                    <![CDATA[
                    SELECT {{column_list}} FROM {{source_table}} (NOLOCK);
                    ]]>
                </sql_bulk>


            </group>
        </foreach>
    </flow>
</pipeline>
