<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
    <variables>
        <variable name="PrimaryDBConnStr" type="string" value="sqlserver://PROD_SERVER:1433?database=master&amp;integrated+security=true&amp;trustServerCertificate=true" />
        <variable name="AnalyticsDBConnStr" type="string" value="sqlserver://PROD_SERVER:1433?database=AdventureWorks_PROD&amp;integrated+security=true&amp;trustServerCertificate=true" />
        <variable name="GetActiveRegionsQuery" value="SELECT database_id, name FROM sys.databases" />

        <!-- Variable to hold the check result (defaults to false) -->
        <variable name="IsMasterDB" type="bool" value="false" />
    </variables>

    <databases>
        <database name="primary_db" connection_string="{{PrimaryDBConnStr}}" />
        <database name="analytics_db" connection_string="{{AnalyticsDBConnStr}}" />
    </databases>

    <scripts>
        <!-- 1. Script checks DB_NAME() and saves 'true' or 'false' into 'IsMasterDB' -->
        <sql id="CheckIfMaster" db="primary_db" output_var="IsMasterDB" description="Check if the currently connected database is the master database">
            <![CDATA[
            SELECT CASE WHEN DB_NAME() = 'master' THEN 'true' ELSE 'false' END AS is_master;
            ]]>
        </sql>

        <!-- 2. Conditional check using the dynamically populated 'IsMasterDB' variable -->
        <if var="IsMasterDB" equals="true">
            <then>
                <sql id="LogMasterNotice" db="primary_db" description="Log confirmation message that connected to master database">
                    <![CDATA[
                    SELECT 'Connected to master database. Running master-level tasks...' AS notice;
                    ]]>
                </sql>

                <foreach id="RegionLoop" language="sql" db="primary_db" var="GetActiveRegionsQuery">
                    <group id="ProcessRegionGroup">
                        <sql id="LogRegionSQL" db="primary_db" description="Log current loop region's database ID and name to status output">
                            <![CDATA[
                            SELECT 'Processing database ID: {{database_id}}, Name: {{name}}' AS current_status;
                            ]]>
                        </sql>
                    </group>
                </foreach>
            </then>

            <else>
                <sql id="LogNonMasterNotice" db="primary_db" description="Log warning message when connection is not on master database">
                    <![CDATA[
                    SELECT 'Not connected to master. Skipping sys.databases loop.' AS notice;
                    ]]>
                </sql>
            </else>
        </if>
    </scripts>
</pipeline>