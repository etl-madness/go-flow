<?xml version="1.0" encoding="UTF-8"?>
<pipeline  description="PostgreSQL example pipeline with preflight checks" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/etl-madness/go-flow/main/xsd/pipeline.xsd">
    <!-- Pipeline Variables -->
    <variables>
        <!-- Connection strings & GitHub API Configuration -->
        <variable name="postgres_conn_str"  description="PostgreSQL connection string" type="string" value="postgres://user:password@localhost:5432/database?sslmode=disable" />

    </variables>

    <databases>
        <database name="database1"  description="Primary PostgreSQL database connection" driver="postgres" connection_string="{{postgres_conn_str}}" />
    </databases>
    <preflight>
        <sql id="preflight_check_access"   description="Preflight check" db="database1">
            <![CDATA[
            SELECT 1;
        ]]>
        </sql>
        <sql id="preflight_check_user"   description="Preflight check 2" db="database1">
            <![CDATA[
            SELECT current_user;
        ]]>
        </sql>
        <sql id="preflight_check_database"  description="Preflight check 3" db="database1">
            <![CDATA[
            SELECT current_database();
        ]]>
        </sql>
    </preflight>
    <flow>
        <!-- Step 1: Ensure Target Table Exists in PostgreSQL -->
        <sql id="rag_document_backup" description="Ensure document_backup table exists" db="database1">
            <![CDATA[
                CREATE TABLE IF NOT EXISTS rag_document_backup (
                    id   TEXT PRIMARY KEY,
                    content  TEXT NOT NULL,
                    metadata  JSONB NOT NULL DEFAULT '{}'::jsonb,
                    embedding  vector(768) NOT NULL,
                    created_at   TIMESTAMPTZ NOT NULL DEFAULT now())
            ]]>
        </sql>

    </flow>
</pipeline>
