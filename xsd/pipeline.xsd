<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ROOT ELEMENT -->
    <xs:element name="pipeline">
        <xs:annotation>
            <xs:documentation>Root element for an ETL Madness Flow pipeline definition.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="variables" type="VariablesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Container for initial pipeline variable declarations.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="databases" type="DatabasesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Container for database connection definitions and connection pool settings.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="preflight" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Preflight execution block containing validation and initialization tasks run prior to the main flow.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="flow" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Main flow execution block containing the primary pipeline steps.</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="description" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation>Human-readable description of the pipeline.</xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- VARIABLE DEFINITIONS -->
    <xs:complexType name="VariablesType">
        <xs:annotation>
            <xs:documentation>Defines a collection of pipeline variables.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="variable" type="VariableType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>An individual variable declaration.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the variables block.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="VariableType">
        <xs:annotation>
            <xs:documentation>Initializes a named pipeline variable with a typed value.</xs:documentation>
        </xs:annotation>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Optional unique identifier for the variable definition.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Name used to reference or interpolate the variable (e.g. {{VarName}}).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="type" use="optional" default="string">
            <xs:annotation>
                <xs:documentation>Data type of the variable value (defaults to string).</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="string" />
                    <xs:enumeration value="int" />
                    <xs:enumeration value="integer" />
                    <xs:enumeration value="bool" />
                    <xs:enumeration value="boolean" />
                    <xs:enumeration value="float" />
                    <xs:enumeration value="double" />
                    <xs:enumeration value="float64" />
                    <xs:enumeration value="datetime" />
                    <xs:enumeration value="date" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Initial value for the variable.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the variable.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- DATABASE DEFINITIONS -->
    <xs:complexType name="DatabasesType">
        <xs:annotation>
            <xs:documentation>Defines a collection of database connection handles and connection pool configurations.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="database" type="DatabaseType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>A database connection configuration.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the database collection.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="DatabaseType">
        <xs:annotation>
            <xs:documentation>Declares a named database connection and pool settings.</xs:documentation>
        </xs:annotation>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Optional identifier for the database configuration.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Unique connection name referenced by db, database, or target_db attributes.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="driver" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Database driver name (e.g. sqlite, postgres, mysql, sqlserver, oracle).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="type" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for driver.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="connection_string" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Driver connection string or DSN. Supports {{VarName}} interpolation.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="max_open_conns" type="xs:positiveInteger" use="optional">
            <xs:annotation>
                <xs:documentation>Maximum open concurrent connections in the connection pool.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="max_idle_conns" type="xs:positiveInteger" use="optional">
            <xs:annotation>
                <xs:documentation>Maximum idle connections retained in the connection pool.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="conn_max_lifetime_seconds" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Maximum duration a connection can be reused before recycling (e.g. 5m or 300).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="workload" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Tuning profile metadata (e.g. oltp, bulk, analytics, batch).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the database connection.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- RECURSIVE NODE CONTAINER -->
    <xs:complexType name="PipelineNodesType">
        <xs:annotation>
            <xs:documentation>Sequence container holding executable pipeline AST steps.</xs:documentation>
        </xs:annotation>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="script" type="ScriptType">
                <xs:annotation>
                    <xs:documentation>Executes code in dynamic Go, Shell (Bash, PowerShell, Cmd), or .NET Script (CSX).</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sql" type="SqlType">
                <xs:annotation>
                    <xs:documentation>Executes standard SQL statements (DDL, DML, queries) on a database.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sql_bulk" type="SqlBulkType">
                <xs:annotation>
                    <xs:documentation>High-performance streaming copy from a source query into a target database table.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="group" type="GroupType">
                <xs:annotation>
                    <xs:documentation>Sequential step container with optional condition evaluation and transaction wrapping.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="parallel" type="ParallelType">
                <xs:annotation>
                    <xs:documentation>Executes child steps concurrently across worker threads with isolated scopes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="if" type="IfType">
                <xs:annotation>
                    <xs:documentation>Conditional branching block evaluating variables or expressions.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="foreach" type="ForEachType">
                <xs:annotation>
                    <xs:documentation>Iterates over rows returned by a SQL query, binding columns as variables.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="loop" type="ForEachType">
                <xs:annotation>
                    <xs:documentation>Alias for foreach iteration loop.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="while" type="WhileType">
                <xs:annotation>
                    <xs:documentation>Repeats execution of child steps while condition expression evaluates to true.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="http_client" type="HttpClientType">
                <xs:annotation>
                    <xs:documentation>Sends HTTP requests and captures response payloads and status codes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="template" type="TemplateType">
                <xs:annotation>
                    <xs:documentation>Renders Go text/template templates using pipeline variables.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="template_html" type="TemplateHtmlType">
                <xs:annotation>
                    <xs:documentation>Renders Go html/template templates with contextual escaping using pipeline variables.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="file_save" type="FileSaveType">
                <xs:annotation>
                    <xs:documentation>Writes text or variable contents to a file on disk.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="file_read" type="FileReadType">
                <xs:annotation>
                    <xs:documentation>Reads file contents from disk into a pipeline variable.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="excel_read" type="ExcelReadType">
                <xs:annotation>
                    <xs:documentation>Reads an Excel worksheet and converts rows to a JSON array variable.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="excel_write" type="ExcelWriteType">
                <xs:annotation>
                    <xs:documentation>Executes a database query and writes the records into an Excel worksheet.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="xml_xpath" type="XmlXPathType">
                <xs:annotation>
                    <xs:documentation>Evaluates XPath queries on an XML file or variable.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="json_path" type="JsonPathType">
                <xs:annotation>
                    <xs:documentation>Evaluates JSONPath expressions on a JSON file or variable.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="yaml_path" type="YamlPathType">
                <xs:annotation>
                    <xs:documentation>Evaluates path queries on a YAML file or variable.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element  ref="assert" />
        </xs:choice>
    </xs:complexType>

    <!-- ASSERT NODE -->
    <xs:element name="assert" type="AssertType">
        <xs:annotation>
            <xs:documentation>Asserts variable values and controls error handling or rollback fallback branches.</xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:complexType name="AssertType">
        <xs:annotation>
            <xs:documentation>Validates variable conditions with halt, warn, continue, or fallback failure handling.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="on_failure" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Optional child execution block executed if the assertion condition fails.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Unique identifier for the assert step.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="var" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Name of the pipeline variable or condition expression to evaluate.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="equals" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Expected value required for assertion to pass.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for equals.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="operator" type="xs:string" use="optional" default="eq">
            <xs:annotation>
                <xs:documentation>Comparison operator (e.g. eq, ==, ne, !=).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="message" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Custom error or warning message emitted on assertion failure.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="on_failure" type="xs:string" use="optional" default="halt">
            <xs:annotation>
                <xs:documentation>Behavior on failure: halt (default), warn, continue, or set_var.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="fail_var" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Optional variable name to set on failure.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="fail_val" type="xs:string" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>Value to assign to fail_var on failure (defaults to true).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- SCRIPT NODE -->
    <xs:complexType name="ScriptType">
        <xs:annotation>
            <xs:documentation>Executes non-SQL scripts in Go, Shell, PowerShell, Bash, or .NET Script (CSX).</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the script step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="language" use="optional">
                    <xs:annotation>
                        <xs:documentation>Execution language runtime (e.g. go, shell, cmd, powershell, pwsh, bash, zsh, dotnet-script, csx).</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="go" />
                            <xs:enumeration value="shell" />
                            <xs:enumeration value="cmd" />
                            <xs:enumeration value="powershell" />
                            <xs:enumeration value="pwsh" />
                            <xs:enumeration value="bash" />
                            <xs:enumeration value="git-bash" />
                            <xs:enumeration value="gitbash" />
                            <xs:enumeration value="zsh" />
                            <xs:enumeration value="ksh" />
                            <xs:enumeration value="csh" />
                            <xs:enumeration value="tcsh" />
                            <xs:enumeration value="dash" />
                            <xs:enumeration value="fish" />
                            <xs:enumeration value="sh" />
                            <xs:enumeration value="dotnet-script" />
                            <xs:enumeration value="csx" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="lang" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for language.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable containing the script code to evaluate dynamically.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for variable.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable that receives the standard output/result of the script.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for output_var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="out_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for output_var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the script step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- HTTP CLIENT NODE -->
    <xs:complexType name="HttpClientType">
        <xs:annotation>
            <xs:documentation>Sends HTTP requests and maps responses to variables.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <!-- Core Request Attributes -->
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the HTTP request step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="uri" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>Target URL / endpoint for the request.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="url" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for uri.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="method" use="optional" default="GET">
                    <xs:annotation>
                        <xs:documentation>HTTP request method (GET, POST, PUT, DELETE, PATCH, etc.).</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="GET" />
                            <xs:enumeration value="POST" />
                            <xs:enumeration value="PUT" />
                            <xs:enumeration value="DELETE" />
                            <xs:enumeration value="PATCH" />
                            <xs:enumeration value="HEAD" />
                            <xs:enumeration value="OPTIONS" />
                            <xs:enumeration value="TRACE" />
                            <xs:enumeration value="CONNECT" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="data" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Request body payload. Supports variable interpolation and Go templating.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="headers" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Custom headers in Header: Value format.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="content_type" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Content-Type request header (e.g. application/json).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>

                <!-- Variable Assignment Attributes -->
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable receiving response body.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="out_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>

                <!-- Status Code Assignment Attributes -->
                <xs:attribute name="status_code_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable receiving the integer HTTP status code (e.g. 200, 404).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="status_code_variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for status_code_var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="status_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for status_code_var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="status_variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for status_code_var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>

                <!-- Go http.Client Options -->
                <xs:attribute name="timeout" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Total request timeout duration (e.g. 30s, 2m).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="max_redirects" type="xs:nonNegativeInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum number of redirect hops allowed.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="follow_redirects" type="xs:boolean" use="optional" default="true">
                    <xs:annotation>
                        <xs:documentation>Whether to automatically follow HTTP redirects.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="cookie_jar" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>Enables an in-memory cookie jar across requests.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>

                <!-- Go http.Transport Options -->
                <xs:attribute name="proxy" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>HTTP/HTTPS proxy server URL.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="tls_insecure_skip_verify" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>Disables SSL/TLS certificate verification when true.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="tls_handshake_timeout" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum duration for TLS handshake negotiation.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="tls_server_name" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Server name for TLS SNI extension.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="tls_min_version" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Minimum accepted TLS version (e.g. 1.2, 1.3).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="tls_max_version" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum accepted TLS version (e.g. 1.3).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="disable_keep_alives" type="xs:boolean" use="optional">
                    <xs:annotation>
                        <xs:documentation>Disables HTTP keep-alives and TCP connection reuse.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="disable_compression" type="xs:boolean" use="optional">
                    <xs:annotation>
                        <xs:documentation>Disables transport level Gzip compression.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="max_idle_conns" type="xs:nonNegativeInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum idle connections retained across all hosts.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="max_idle_conns_per_host" type="xs:nonNegativeInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum idle connections retained per target host.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="max_conns_per_host" type="xs:nonNegativeInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum total connections per host.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="idle_conn_timeout" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum duration an idle connection remains open before closing.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="response_header_timeout" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum duration to wait for server response headers.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="expect_continue_timeout" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Timeout for Expect: 100-continue response headers.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="max_response_header_bytes" type="xs:long" use="optional">
                    <xs:annotation>
                        <xs:documentation>Limit on response header size in bytes.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="write_buffer_size" type="xs:nonNegativeInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Write buffer size in bytes.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="read_buffer_size" type="xs:nonNegativeInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Read buffer size in bytes.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="force_attempt_http2" type="xs:boolean" use="optional">
                    <xs:annotation>
                        <xs:documentation>Forces HTTP/2 negotiation when custom TLS transport is configured.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the HTTP request step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- GROUP NODE -->
    <xs:complexType name="GroupType">
        <xs:annotation>
            <xs:documentation>Organizes child steps sequentially with optional condition checking and transaction wrapping.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the group.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable or condition expression evaluated before executing group.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="if_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="equals" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Expected value required for the condition to pass.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="val" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="value" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="if_val" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="if_equals" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="condition" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Inline condition expression.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="cond" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for condition.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="transaction" type="xs:boolean" use="optional">
                    <xs:annotation>
                        <xs:documentation>Wraps child steps in an atomic database transaction when true.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="db" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Database connection name for the transaction.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="database" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for db.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the group block.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- PARALLEL NODE -->
    <xs:complexType name="ParallelType">
        <xs:annotation>
            <xs:documentation>Executes child steps concurrently across worker threads with isolated variable environments.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="max_threads" type="xs:positiveInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Maximum concurrency thread pool limit (defaults to 4).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="threads" type="xs:positiveInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for max_threads.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="concurrency" type="xs:positiveInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for max_threads.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the parallel block.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- IF / CONDITIONAL NODE -->
    <xs:complexType name="IfType">
        <xs:annotation>
            <xs:documentation>Conditional execution branch container with optional then and else branches.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="then" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Container for steps executed when condition evaluates to true.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="else" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Container for steps executed when condition evaluates to false.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <!-- Allows inline children without explicit <then> tags -->
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="script" type="ScriptType" />
                <xs:element name="sql" type="SqlType" />
                <xs:element name="sql_bulk" type="SqlBulkType" />
                <xs:element name="group" type="GroupType" />
                <xs:element name="parallel" type="ParallelType" />
                <xs:element name="if" type="IfType" />
                <xs:element name="foreach" type="ForEachType" />
                <xs:element name="loop" type="ForEachType" />
                <xs:element name="while" type="WhileType" />
                <xs:element name="http_client" type="HttpClientType" />
                <xs:element name="template" type="TemplateType" />
                <xs:element name="template_html" type="TemplateHtmlType" />
                <xs:element name="file_save" type="FileSaveType" />
                <xs:element name="file_read" type="FileReadType" />
                <xs:element name="excel_read" type="ExcelReadType" />
                <xs:element name="excel_write" type="ExcelWriteType" />
                <xs:element name="xml_xpath" type="XmlXPathType" />
                <xs:element name="json_path" type="JsonPathType" />
                <xs:element name="yaml_path" type="YamlPathType" />
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Unique identifier for the conditional step.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="var" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Variable or condition expression to evaluate.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="if_var" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for var.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="equals" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Expected value required for true branch.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="val" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for equals.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for equals.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="if_val" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for equals.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="if_equals" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for equals.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="condition" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Inline condition expression.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="cond" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for condition.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the conditional step.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- FOREACH / LOOP NODE -->
    <xs:complexType name="ForEachType">
        <xs:annotation>
            <xs:documentation>Executes nested child steps for each row returned by the SQL driver query.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the foreach loop.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="language" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Driver query language (defaults to sql).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="lang" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for language.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="db" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Database connection name for the driver query.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="database" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for db.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable containing the SQL driver query.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for variable.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the loop.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- WHILE LOOP NODE -->
    <xs:complexType name="WhileType">
        <xs:annotation>
            <xs:documentation>Executes child steps repeatedly while the specified condition remains true.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the while loop.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable or condition expression evaluated before each iteration.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="if_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="equals" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Expected value required to continue looping.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="val" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="value" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="if_val" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="if_equals" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for equals.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="condition" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Inline condition expression.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="cond" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for condition.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="max_iterations" type="xs:positiveInteger" use="optional" default="1000">
                    <xs:annotation>
                        <xs:documentation>Safety limit for maximum iterations to prevent infinite loops (defaults to 1000).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="max_loops" type="xs:positiveInteger" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for max_iterations.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the while loop.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- TEMPLATE NODE -->
    <xs:complexType name="TemplateType">
        <xs:annotation>
            <xs:documentation>Renders a Go text/template template using current pipeline variables.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the template step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="name" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Template name identifier.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="file" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Path to an external template file.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="engine" type="xs:string" use="optional" default="text">
                    <xs:annotation>
                        <xs:documentation>Template engine (defaults to text).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable receiving the rendered output.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="mode" type="xs:string" use="optional" default="text">
                    <xs:annotation>
                        <xs:documentation>Output mode: text or summary.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable receiving the rendered output.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the template step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- HTML TEMPLATE NODE -->
    <xs:complexType name="TemplateHtmlType">
        <xs:annotation>
            <xs:documentation>Renders a Go html/template template with HTML escaping using pipeline variables.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the HTML template step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="name" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Template name identifier.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="file" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Path to an external HTML template file.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="engine" type="xs:string" use="optional" default="html">
                    <xs:annotation>
                        <xs:documentation>Template engine (defaults to html).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable receiving the rendered HTML output.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="mode" type="xs:string" use="optional" default="text">
                    <xs:annotation>
                        <xs:documentation>Output mode: text or summary.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable receiving the rendered HTML output.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the HTML template step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- FILE SAVE NODE -->
    <xs:complexType name="FileSaveType">
        <xs:annotation>
            <xs:documentation>Writes text content or variable data to a file on disk.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the file save step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="file" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Target destination file path.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="path" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for file.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="filename" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for file.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable containing the content to write to disk.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="append" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>When true, appends content to file instead of overwriting.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the file save step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- FILE READ NODE -->
    <xs:complexType name="FileReadType">
        <xs:annotation>
            <xs:documentation>Reads raw file content from disk into a pipeline variable.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the file read step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="file" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Source file path to read from disk.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="path" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for file.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="filename" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for file.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable that receives the file content.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="out_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the file read step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- EXCEL READ/WRITE NODES -->
    <xs:complexType name="ExcelReadType">
        <xs:annotation>
            <xs:documentation>Reads an Excel workbook sheet and stores records as a JSON string in a variable.</xs:documentation>
        </xs:annotation>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Unique identifier for the Excel read step.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="file" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Path to the Excel file (.xlsx).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="sheet" type="xs:string" use="optional" default="Sheet1">
            <xs:annotation>
                <xs:documentation>Target sheet name to read (defaults to the first sheet or Sheet1).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="header" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>Whether the first row contains column headers (defaults to true).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="var" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Variable receiving the extracted records as a JSON array string.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="output_var" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for var.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the Excel read step.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ExcelWriteType">
        <xs:annotation>
            <xs:documentation>Executes a database SQL query and writes the result rows directly to an Excel sheet.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique identifier for the Excel write step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="file" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>Destination Excel file path (.xlsx).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="sheet" type="xs:string" use="optional" default="Sheet1">
                    <xs:annotation>
