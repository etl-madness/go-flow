                    <xs:annotation>
                        <xs:documentation>Preserves explicit NULL values during bulk insert when true.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the bulk SQL step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
