<?xml version="1.0" encoding="UTF-8"?>
<pipeline xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/etl-madness/flow/main/xsd/pipeline.xsd">
    <variables>
        <variable name="TargetTable" value="processed_logs" description="Default destination table" type="string" />
        <variable name="log_db_cs" value="sqlserver://T15P:1433?database=PROTO&amp;integrated+security=true&amp;trustServerCertificate=true" description="Connection String for Log DB" type="string" />
    </variables>

    <databases>
        <database name="local_sqlite" driver="sqlite" connection_string="./pipeline_data.db" />
        <database name="log_db" driver="sqlserver" connection_string="{{log_db_cs}}" conn_max_lifetime_seconds="300" max_idle_conns="10" max_open_conns="25" />
    </databases>

    <preflight>
        <sql id="pre_select_from_db_1" db="log_db">
            SELECT 1
        </sql>
        <sql id="PRE_TABLE_RUN_CHECK" db="log_db" output_var="PRE_TABLE_AVAIL">
            SELECT CAST(
                            CASE 
                                WHEN EXISTS (
                                    SELECT 1
                                    FROM [PROTO].[dbo].[pipeline_runs]
                                )
                                THEN 1
                                ELSE 0
                            END AS VARCHAR(1)
                        );
        </sql>
        <if id="PRE_IF_TABLE_COUNT_GT_0" var="PRE_TABLE_AVAIL" equals="&quot;1&quot;">
            <then>
                <sql id="PRE_IF_SUCCESS" db="log_db">
                    SELECT COUNT(*) FROM  [PROTO].[dbo].[pipeline_runs]
                </sql>
            </then>
            <else>
                <template id="PRE_IF_FAIL_STEP">
                    {{.PRE_TABLE_AVAIL}} Failed
                </template>
            </else>
        </if>
    </preflight>

    <flow>
        <sql id="GET_LOGS" db="log_db">
            SELECT  [run_id]
                  ,[file_path]
                  ,[config_path]
                  ,[status]
                  ,[started_at]
                  ,[finished_at]
                  ,[duration_ms]
                  ,[task_count]
                  ,[error_class]
                  ,[error_message]
                  ,[created_at]
              FROM [PROTO].[dbo].[pipeline_runs]
        </sql>
    </flow>
</pipeline>
