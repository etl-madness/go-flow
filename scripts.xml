<?xml version="1.0" encoding="UTF-8"?>
<pipeline xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/etl-madness/flow/main/xsd/pipeline.xsd">
    <variables>
        <variable name="TargetTable" description="Default destination table" type="string" value="processed_logs" />
        <variable name="log_db_cs" description="Connection String for Log DB" type="string" value="sqlserver://T15P:1433?database=PROTO&amp;integrated+security=true&amp;trustServerCertificate=true" />
    </variables>

    <databases>
        <database name="local_sqlite" driver="sqlite" connection_string="./pipeline_data.db" />
        <database name="log_db" driver="sqlserver" connection_string="{{log_db_cs}}" conn_max_lifetime_seconds="300" max_idle_conns="10" max_open_conns="25" />
    </databases>

    <preflight>
        <sql id="pre_select_from_db_1" db="log_db">
            SELECT 1
        </sql>
    </preflight>

    <flow>
        <sql id="GET_LOGS" db="log_db">
            SELECT  [run_id]
                  ,[file_path]
                  ,[config_path]
                  ,[status]
                  ,[started_at]
                  ,[finished_at]
                  ,[duration_ms]
                  ,[task_count]
                  ,[error_class]
                  ,[error_message]
                  ,[created_at]
              FROM [PROTO].[dbo].[pipeline_runs]
        </sql>
    </flow>
</pipeline>
